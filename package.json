{
  "name": "rasd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "رصد — أداة فحص بصري للمتصفح: التقاط، فحص، قياس، ألوان، مقارنة، وتوثيق.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run build:bundle && pnpm run verify:dist",
    "build:bundle": "vite build && pnpm run build:content",
    "build:content": "vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:repeat": "node scripts/test-repeat.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "tokens:sync": "node scripts/tokens-sync.mjs",
    "stages:sync": "node scripts/stages-sync.mjs",
    "stages:check": "node scripts/stages-sync.mjs --check",
    "waves:check": "node scripts/waves-plan.mjs",
    "waves:board": "node scripts/waves-board.mjs",
    "fonts:sync": "node scripts/fonts-sync.mjs",
    "icons:sync": "node scripts/icons-sync.mjs",
    "icons:brand": "node scripts/brand-icons.mjs",
    "tokens:check": "node scripts/tokens-sync.mjs --check",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "fixtures:serve": "node scripts/fixtures-serve.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:load": "node scripts/verify-load.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "verify:overlay": "node scripts/verify-overlay.mjs",
    "verify:picker": "node scripts/verify-picker.mjs",
    "verify:measure": "node scripts/verify-measure.mjs",
    "verify:palette": "node scripts/verify-palette.mjs",
    "verify:colour": "node scripts/verify-colour.mjs",
    "verify:editor": "node scripts/verify-editor.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "verify:fullpage": "node scripts/verify-fullpage.mjs",
    "verify:inspect": "node scripts/verify-inspect.mjs",
    "verify:popup": "node scripts/verify-popup.mjs",
    "verify:issues": "node scripts/verify-issues.mjs",
    "verify:capturing": "node scripts/verify-capturing.mjs",
    "verify:capture": "node scripts/verify-capture.mjs",
    "verify:compare": "node scripts/verify-compare.mjs",
    "verify:compare-diff": "node scripts/verify-compare-diff.mjs",
    "verify:activate": "node scripts/verify-activate.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:share": "node scripts/verify-share.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:memory": "node scripts/verify-memory.mjs",
    "verify:lighthouse": "node scripts/verify-lighthouse.mjs",
    "verify:wave": "node scripts/wave-verify.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "entrypoints:lint": "node scripts/entrypoints-lint.mjs",
    "design:shots": "node scripts/design-shots.mjs",
    "guards:sync": "node scripts/guards-sync.mjs",
    "guards:check": "node scripts/guards-sync.mjs --check",
    "gate:a": "node scripts/gate-a.mjs",
    "zip": "node scripts/zip.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run tokens:check && pnpm run verify:tokens && pnpm run test:coverage"
  },
  "dependencies": {
    "@preact/signals": "2.11.1",
    "culori": "4.0.2",
    "idb": "8.0.3",
    "pdf-lib": "1.17.1",
    "pixelmatch": "6.0.0",
    "preact": "10.29.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.7",
    "@types/culori": "4.0.1",
    "@types/node": "24.10.1",
    "@types/pixelmatch": "^5.2.6",
    "@vitest/coverage-v8": "4.1.11",
    "@webext-core/fake-browser": "2.0.1",
    "axe-core": "^4.13.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.17.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.11.0",
    "happy-dom": "20.11.12",
    "lighthouse": "13.5.0",
    "prettier": "3.9.6",
    "puppeteer-core": "25.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
